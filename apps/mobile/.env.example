# Copy to apps/mobile/.env.local. These values are bundled into the client.
EXPO_PUBLIC_SUPABASE_URL=http://10.0.2.2:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_local_supabase_anon_key
EXPO_PUBLIC_APPLE_AUTH_ENABLED=false
EXPO_PUBLIC_IMAGE_TRANSFORM=false

# Optional; the current app uses a console tracker, not production analytics.
EXPO_PUBLIC_POSTHOG_KEY=

# NEVER put SUPABASE_SERVICE_ROLE_KEY, FCM service-account JSON or other server
# secrets in EXPO_PUBLIC_* variables or in the mobile app.
