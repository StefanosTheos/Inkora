{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "baseUrl": ".",
    "paths": {
      "@inkora/domain": ["packages/domain/src"],
      "@inkora/domain/*": ["packages/domain/src/*"],
      "@inkora/data-access": ["packages/data-access/src"],
      "@inkora/data-access/*": ["packages/data-access/src/*"],
      "@inkora/design-tokens": ["packages/design-tokens/src"],
      "@inkora/ui-native": ["packages/ui-native/src"],
      "@inkora/ui-web": ["packages/ui-web/src"],
      "@inkora/analytics": ["packages/analytics/src"],
      "@inkora/ai": ["ai/src"]
    }
  },
  "exclude": ["node_modules", "dist", ".next", ".expo"]
}
