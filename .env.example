# Variable reference. Use apps/mobile/.env.example -> apps/mobile/.env.local
# and apps/web/.env.example -> apps/web/.env.local for application startup.
# Root .env is not automatically loaded by both frameworks or upload.mjs.
# NEVER commit real secrets. See docs/SETUP.md for exact runtime consumers.

# --- Supabase (public, safe for clients) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only (NEVER expose to clients / NEVER prefix with PUBLIC) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Analytics / Monitoring ---
NEXT_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_KEY=
SENTRY_DSN=

# --- Firebase Cloud Messaging (server-side Edge Function only) ---
# Configure FCM_SERVICE_ACCOUNT in the notify-dispatch secret store, not clients.

# --- Auth feature flags ---
# Apple sign-in needs a paid Apple Developer account; keep false until the
# Apple provider is configured in Supabase. The button is hidden while false.
EXPO_PUBLIC_APPLE_AUTH_ENABLED=false
NEXT_PUBLIC_APPLE_AUTH_ENABLED=false

# Analytics/monitoring names above are references, not proof that adapters are
# wired. See docs/SETUP.md and docs/ROADMAP.md for integration status.
