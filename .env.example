# Copy to .env and fill. NEVER commit real secrets.

# --- Supabase (public, safe for clients) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only (NEVER expose to clients / NEVER prefix with PUBLIC) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Analytics / Monitoring ---
NEXT_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_KEY=
SENTRY_DSN=

# --- Firebase Cloud Messaging (push) ---
FCM_SERVER_KEY=

# --- Auth feature flags ---
# Apple sign-in needs a paid Apple Developer account; keep false until the
# Apple provider is configured in Supabase. The button is hidden while false.
EXPO_PUBLIC_APPLE_AUTH_ENABLED=false
NEXT_PUBLIC_APPLE_AUTH_ENABLED=false

# TODO: document each variable and which app/runtime consumes it.
